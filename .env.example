# Session (iron-session). Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-at-least-32-chars-long-dev-only-xxxx"

# Database
DATABASE_URL="postgresql://bluesky:bluesky@localhost:5432/bluesky_spaces?schema=public"

# Next.js
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://rabble.town"

# Bluesky OAuth (placeholders for later chunks)
BLUESKY_OAUTH_CLIENT_ID=""
BLUESKY_OAUTH_REDIRECT_URI="http://rabble.town/api/oauth/callback"

# Hosted (public) OAuth flow. Leave PUBLIC_URL empty in dev to use the
# loopback flow; set it to switch to private_key_jwt against /.well-known/jwks.json.
PUBLIC_URL=""
JWKS_PRIVATE_KEY=""
JWKS_PUBLIC_KEY=""
LOGO_URL="http://rabble.town/logo.png"

# LiveKit
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret0123456789abcdef0123456789abcdef"
# Internal URL for server-to-server calls (token minting, room service).
# docker-compose overrides this to ws://livekit:7880 (Docker network).
# For standalone local dev (npm run dev + separate LiveKit): ws://localhost:7880
LIVEKIT_URL="ws://localhost:7880"
# Public URL that browsers connect to for WebSocket signaling.
# docker-compose routes /rtc/* through Caddy on port 3000, so set this to
# ws://localhost:3000 locally. For a production domain with a separate
# LiveKit subdomain use wss://livekit.yourdomain.com.
LIVEKIT_PUBLIC_URL="ws://localhost:3000"
# The IP LiveKit advertises as ICE host candidate. Set to your LAN IP
# (e.g. 192.168.1.x) if remote browsers need to reach the media plane.
# Loopback (127.0.0.1) works when both browser and LiveKit run on the
# same machine.
LIVEKIT_NODE_IP="127.0.0.1"

# Recording / S3 (used by LiveKit Egress and the app for signed download URLs)
# In docker-compose the app reaches MinIO at http://minio:9000 via the Docker
# network; for local dev outside compose, override S3_ENDPOINT to the
# reachable address (e.g. http://127.0.0.1:9000).
RECORDING_BUCKET="rabble-recordings"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio-secret"
S3_REGION="us-east-1"
# URL the Egress service uses to reach the LiveKit HTTP/WS API. Inside
# docker-compose this is the livekit container; outside compose, point it
# at your local LiveKit.
EGRESS_WS_URL="ws://livekit:7880"
