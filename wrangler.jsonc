{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top level is the development environment (rabble.rodeo, Worker
  // `rabble-dev`). Production (rabble.radio, Worker `rabble-prod`) is the
  // `production` environment below with its own database, bucket, secrets
  // and domain: `pnpm cf:deploy:prod`, `pnpm d1:migrate:prod`,
  // `wrangler secret put NAME --env production`. Bindings and vars are not
  // inherited by an environment, so every one is repeated there.
  "name": "rabble-dev",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rabble-dev" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rabble-dev",
      "database_id": "b1415b00-28e3-4cd7-88de-93e089211cd5",
      "migrations_dir": "prisma/d1"
    }
  ],
  "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "rabble-dev-recordings" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "routes": [{ "pattern": "rabble.rodeo", "custom_domain": true }],
  "observability": { "enabled": true },
  // Plain config. Secrets (SESSION_SECRET, JWKS_PRIVATE_KEY, LIVEKIT_*, S3_*)
  // are set with `wrangler secret put`.
  "vars": {
    "APP_NAME": "Rabble",
    "PUBLIC_URL": "https://rabble.rodeo",
    "NEXT_PUBLIC_APP_URL": "https://rabble.rodeo",
    "LOGO_URL": "https://rabble.rodeo/logo.png",
    "S3_REGION": "auto",
    "S3_ENDPOINT": "https://0f8fe574f3489eda5a599104efd24d26.r2.cloudflarestorage.com",
    "RECORDING_BUCKET": "rabble-dev-recordings",
    "LOG_LEVEL": "info",
    // Who can read /admin/feedback and GET /api/feedback (DIDs or handles).
    "FEEDBACK_ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
    // Who can read /admin/reports and GET /api/reports (DIDs or handles).
    "REPORT_ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
    // Who can read /admin and act on POST /api/admin/users (DIDs or handles).
    "ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
    // Shown to a banned user who tries to log in.
    "SUPPORT_EMAIL": "justin.garrison@siderolabs.com",
    // Web Push (VAPID). The private key is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BMtZBKmewyV3-_C2qn97wceZqSA-hW5NEGcyhOyDS_AJOFu8OJ00FuMBmZ0XVuSECiOu4AP3BMn_GcwilLz7ulA",
    "VAPID_SUBJECT": "mailto:justin.garrison@siderolabs.com"
    // Cloudflare Web Analytics is off until the owner creates the site
    // (Account Home → Web Analytics → Add a site) and adds
    // "NEXT_PUBLIC_CF_BEACON_TOKEN" here with the beacon token it prints.
  },
  "env": {
    "production": {
      "name": "rabble-prod",
      "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "rabble-prod" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rabble-prod",
          "database_id": "b3c5287f-9882-4ca7-b1ff-76641f3c1ce6",
          "migrations_dir": "prisma/d1"
        }
      ],
      "r2_buckets": [{ "binding": "RECORDINGS", "bucket_name": "rabble-prod-recordings" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "routes": [{ "pattern": "rabble.radio", "custom_domain": true }],
      // Production answers on rabble.radio only; no rabble-prod.*.workers.dev.
      "workers_dev": false,
      "observability": { "enabled": true },
      // Secrets for this environment are separate from rabble-dev's and set
      // with `wrangler secret put NAME --env production` (docs/DEPLOY.md).
      "vars": {
        "APP_NAME": "Rabble",
        "PUBLIC_URL": "https://rabble.radio",
        "NEXT_PUBLIC_APP_URL": "https://rabble.radio",
        "LOGO_URL": "https://rabble.radio/logo.png",
        "S3_REGION": "auto",
        "S3_ENDPOINT": "https://0f8fe574f3489eda5a599104efd24d26.r2.cloudflarestorage.com",
        "RECORDING_BUCKET": "rabble-prod-recordings",
        "LOG_LEVEL": "info",
        "FEEDBACK_ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
        "REPORT_ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
        "ADMIN_DIDS": "did:plc:p7uix7mresfq4nfzxp3klgfa,did:plc:pu72ebuazc53cwafmuhll5t3",
        "SUPPORT_EMAIL": "justin.garrison@siderolabs.com",
        "VAPID_SUBJECT": "mailto:justin.garrison@siderolabs.com",
        // Web Push (VAPID) public key for production; the private key is the
        // VAPID_PRIVATE_KEY secret of rabble-prod. Generated with scripts/gen-vapid.mjs.
        "VAPID_PUBLIC_KEY": "BNHs4j8QOgekeOp9ICPToxt9xRuNplblaDiCG2nm_oVBb08_OvteEpnIPxht7EvoXQoPEyxNPZOr1qIMKm05ug0"
        // Add "NEXT_PUBLIC_CF_BEACON_TOKEN" here once a production Web
        // Analytics site exists for rabble.radio; see the top-level vars.
      }
    }
  }
}
