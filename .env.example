# Database
DATABASE_URL="postgresql://bluesky:bluesky@localhost:5432/bluesky_spaces?schema=public"

# Next.js
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://rabble.town"

# Bluesky OAuth (placeholders for later chunks)
BLUESKY_OAUTH_CLIENT_ID=""
BLUESKY_OAUTH_REDIRECT_URI="http://rabble.town/api/oauth/callback"

# Hosted (public) OAuth flow. Leave PUBLIC_URL empty in dev to use the
# loopback flow; set it to switch to private_key_jwt against /.well-known/jwks.json.
PUBLIC_URL=""
JWKS_PRIVATE_KEY=""
JWKS_PUBLIC_KEY=""
LOGO_URL="http://rabble.town/logo.png"

# LiveKit (placeholders for later chunks)
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""
# Internal LiveKit URL used for server-to-server calls (token minting,
# egress). Inside docker-compose this is ws://livekit:7880 so the app
# container can reach the LiveKit container over the Docker network.
LIVEKIT_URL=""
# Public LiveKit URL exposed to browser clients. Caddy reverse-proxies
# /rtc/* on the public port (443 -> 3000) to the LiveKit container, so
# the browser connects to wss://rabble.exe.xyz (no port) and the LiveKit
# SDK appends /rtc/v1/... to that base URL. For local dev outside exe.dev,
# set LIVEKIT_PUBLIC_URL=ws://localhost:7880 to connect directly.
LIVEKIT_PUBLIC_URL="wss://rabble.exe.xyz"

# Recording / S3 (used by LiveKit Egress and the app for signed download URLs)
# In docker-compose the app reaches MinIO at http://minio:9000 via the Docker
# network; for local dev outside compose, override S3_ENDPOINT to the
# reachable address (e.g. http://127.0.0.1:9000).
RECORDING_BUCKET="rabble-recordings"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="minio"
S3_SECRET_KEY="minio-secret"
S3_REGION="us-east-1"
# URL the Egress service uses to reach the LiveKit HTTP/WS API. Inside
# docker-compose this is the livekit container; outside compose, point it
# at your local LiveKit.
EGRESS_WS_URL="ws://livekit:7880"
