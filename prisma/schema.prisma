// Prisma schema for Cloudflare D1 (SQLite).
//
// The client is generated without a Rust engine (`engineType = "client"`) and
// talks to D1 through @prisma/adapter-d1 (see src/lib/db.ts). D1 has no
// transactions, so `$transaction` calls run statement by statement; code that
// uses them must stay idempotent.
//
// SQLite has no arrays or JSON columns: tags live in join tables and JSON
// payloads are stored as text.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id          String   @id @default(cuid())
  did         String   @unique
  handle      String
  displayName String?
  avatarUrl   String?
  /// Set by a platform admin (src/lib/admin.ts). A banned user is treated as
  /// signed out: they cannot log in, join a space while identified, or host.
  bannedAt    DateTime?
  banReason   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hostedSpaces Space[]

  @@index([handle])
  @@index([bannedAt])
  @@index([createdAt])
}

/// A station: the durable thing a host creates and can go live on many times.
model Space {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  description String?
  hostId      String
  isLive      Boolean   @default(false)
  scheduledAt DateTime?
  /// When an unscheduled empty space should be considered expired.
  expiresAt   DateTime?
  /// Last time the room was observed empty; null while occupied.
  emptySince  DateTime?
  /// One of "scheduled", "active", "live", "ended", "expired".
  status      String    @default("active")
  /// Live occupancy snapshots from LiveKit plus the running reaction count.
  listenerCount Int @default(0)
  speakerCount  Int @default(0)
  reactionCount Int @default(0)
  /// Lifetime totals rolled up from ShowSession rows plus the like count.
  likeCount      Int       @default(0)
  sessionCount   Int       @default(0)
  totalListeners Int       @default(0)
  hostedSeconds  Int       @default(0)
  lastLiveAt     DateTime?
  /// Pre-show music mood (see src/lib/music.ts), null for silence.
  musicMood      String?
  /// True while the music tile sits in the on-stage grid; false once a host
  /// removes it from the stage while on air (issue #111). It moves into the
  /// audience/listening list instead of disappearing, and re-inviting it
  /// flips this back to true without touching musicMood. Ignored off air,
  /// where the tile is always on stage once a mood is set.
  musicOnStage   Boolean   @default(true)
  /// True once the host has turned this show into its own podcast feed,
  /// scoped to just its published recordings (/podcast/[handle]/show/[id]/feed.xml).
  podcastFeedEnabled Boolean @default(false)
  /// True for a show whose title is the auto-generated "Start a show"
  /// default (handle/display name derived), so findDefaultHostedSpace can
  /// look it up directly instead of recomputing and matching that title.
  /// Cleared the moment a host edits the title themselves.
  isDefaultTitled Boolean @default(false)
  /// AT URI of the `community.lexicon.calendar.event` record published in the
  /// host's own repo for a scheduled show (issue #154), null when none has
  /// been published (or it was never a scheduled show).
  calendarEventUri String?
  calendarEventCid String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  host       User          @relation(fields: [hostId], references: [did], onDelete: Cascade)
  tags       SpaceTag[]
  recordings Recording[]
  sessions   ShowSession[]
  reactions  ShowReaction[]
  likes      ShowLike[]
  invites    StageInvite[]
  speakers   StageSpeaker[]
  blocks     StageBlock[]
  reminders  ShowReminder[]
  followers  ShowFollow[]

  @@index([hostId])
  @@index([isLive])
  @@index([createdAt])
  @@index([status])
  @@index([scheduledAt])
  @@index([expiresAt])
  @@index([emptySince])
}

/// Up to 3 category tags per station (YouTube category list).
model SpaceTag {
  spaceId String
  tag     String

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, tag])
  @@index([tag])
}

/// Per-session recording row, created when the host goes live and LiveKit
/// egress starts. `expiresAt` drives the cleanup sweep.
model Recording {
  id          String    @id @default(cuid())
  spaceId     String
  egressId    String    @unique
  /// One of "starting", "available", "failed", "expired".
  status      String    @default("starting")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  expiresAt   DateTime
  s3Key       String
  s3Bucket    String
  contentType String    @default("audio/mpeg")
  sizeBytes   Int?
  downloadUrl String?
  hostDid     String
  /// True once the host has published this recording as a podcast episode.
  /// Published recordings are skipped by the expiry sweep.
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@index([expiresAt])
  @@index([status])
  @@index([hostDid, published])
}

/// Bluesky OAuth session, keyed by DID. `data` is the serialized session.
model OAuthSession {
  id        String   @id @default(cuid())
  did       String   @unique
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// In-flight OAuth authorization state (PKCE verifier, DPoP key, ...), keyed
/// by the state parameter. Short-lived; rows are deleted on callback.
model OAuthState {
  key       String   @id
  data      String
  createdAt DateTime @default(now())
}

/// A host's invitation for a listener to come on stage.
model StageInvite {
  spaceId        String
  targetIdentity String
  hostDid        String
  roomName       String
  createdAt      DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, targetIdentity])
}

/// Who currently holds a speaker token in a station's room.
model StageSpeaker {
  spaceId  String
  identity String

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, identity])
}

/// Identities the host has blocked from a station.
model StageBlock {
  spaceId  String
  identity String

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, identity])
}

/// One live run of a Space ("show"), from the host going live until they end
/// it or the sweep expires it. Lifetime totals live on Space; these rows are
/// what leaderboards and weekly digests aggregate from.
model ShowSession {
  id              String    @id @default(cuid())
  spaceId         String
  hostDid         String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  /// Most simultaneous participants other than the host.
  peakListeners   Int       @default(0)
  /// Distinct identities other than the host (anonymous ones included).
  uniqueListeners Int       @default(0)
  /// Distinct signed-in participants other than the host who took the stage.
  guestCount      Int       @default(0)
  reactionCount   Int       @default(0)
  likeCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  space          Space               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  /// Tags on the Space when the session started (a Space can be re-tagged).
  tags           ShowSessionTag[]
  participations ShowParticipation[]
  reactions      ShowReaction[]

  @@index([spaceId, startedAt])
  @@index([hostDid, startedAt])
  @@index([endedAt])
  @@index([startedAt])
}

model ShowSessionTag {
  sessionId String
  tag       String

  session ShowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@id([sessionId, tag])
  @@index([tag])
}

/// One participant's presence in one ShowSession. `identity` is a DID or an
/// anonymous `anon:<uuid>` identity; `role` is the highest role reached.
model ShowParticipation {
  id           String    @id @default(cuid())
  sessionId    String
  spaceId      String
  identity     String
  anonymous    Boolean   @default(false)
  /// "listener", "speaker" or "host".
  role         String    @default("listener")
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?
  /// Seconds spent on stage, accumulated when leaving the stage or the room.
  stageSeconds Int       @default(0)
  stageSince   DateTime?

  session ShowSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, identity])
  @@index([identity, joinedAt])
  @@index([spaceId])
  @@index([joinedAt])
}

/// One reaction tap. Counters on Space and ShowSession are kept in step; the
/// rows exist so digests can window by time and topic.
model ShowReaction {
  id        String   @id @default(cuid())
  spaceId   String
  sessionId String?
  did       String
  kind      String   @default("reaction")
  createdAt DateTime @default(now())

  space   Space        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  session ShowSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([spaceId, createdAt])
  @@index([sessionId])
  @@index([did])
  @@index([createdAt])
}

/// A signed-in user liking a show. One per user per Space.
model ShowLike {
  id        String   @id @default(cuid())
  spaceId   String
  did       String
  createdAt DateTime @default(now())

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, did])
  @@index([did])
  @@index([createdAt])
}

/// Materialized per-host, per-topic totals behind the host leaderboard. The
/// row with tag "*" is the host's all-topics total. Updated when a session
/// ends and when likes land; rebuildable from ShowSession/ShowParticipation.
model HostTopicStats {
  id               String    @id @default(cuid())
  hostDid          String
  tag              String
  showsHosted      Int       @default(0)
  guestAppearances Int       @default(0)
  likes            Int       @default(0)
  reactions        Int       @default(0)
  listeners        Int       @default(0)
  hostedSeconds    Int       @default(0)
  guestSeconds     Int       @default(0)
  lastLiveAt       DateTime?
  updatedAt        DateTime  @updatedAt

  @@unique([hostDid, tag])
  @@index([tag, listeners])
  @@index([tag, hostedSeconds])
}

/// Materialized per-topic totals (one row per tag).
model TopicStats {
  tag           String    @id
  shows         Int       @default(0)
  listeners     Int       @default(0)
  reactions     Int       @default(0)
  likes         Int       @default(0)
  hostedSeconds Int       @default(0)
  lastLiveAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

/// A problem report or suggestion sent from the feedback button. `context`
/// is a JSON blob of client state (page/screen, room state, recent errors)
/// and environment (device, OS, app version) captured when it was sent.
model Feedback {
  id         String   @id @default(cuid())
  did        String?
  handle     String?
  category   String   @default("problem")
  message    String
  email      String?
  platform   String   @default("web")
  appVersion String?
  page       String?
  spaceId    String?
  userAgent  String?
  context    String   @default("{}")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([did])
}

/// A report filed by a show's host against one of their speakers, naming
/// what happened for an admin to review and decide whether the reported
/// user should be removed from the platform. Reports outlive the space
/// they were filed from, so no relation/cascade to Space.
model Report {
  id             String   @id @default(cuid())
  spaceId        String
  reporterDid    String
  reporterHandle String?
  reportedDid    String
  reportedHandle String?
  reason         String
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([reportedDid])
}

/// "Notify me" on a scheduled show. `notifiedAt` is set once the viewer has
/// been told the show went on air (the clients poll for due reminders).
model ShowReminder {
  spaceId    String
  did        String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, did])
  @@index([did])
}

/// A listener following a host, notified whenever any of the host's shows
/// goes live (scheduled or instant-started) rather than one scheduled show.
/// Unlike ShowReminder's one-time fire, `notifiedAt` is cleared each time
/// the host goes live (see resetHostFollowNotifications in
/// src/lib/host-follows.ts) so the same follow fires again every session.
model HostFollow {
  hostDid    String
  did        String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@id([hostDid, did])
  @@index([did])
  @@index([hostDid, notifiedAt])
}

/// A listener following one specific named show, notified only when its
/// host goes live as the host of that exact show (Space.hostId never
/// changes, so a guest appearance on another host's show never fires this).
/// Like HostFollow, `notifiedAt` is cleared each time the show goes live
/// (see resetShowFollowNotifications in src/lib/show-follows.ts) so the
/// same follow fires again every session.
model ShowFollow {
  spaceId    String
  did        String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([spaceId, did])
  @@index([did])
  @@index([spaceId, notifiedAt])
}

/// A browser's Web Push subscription (one per browser profile per user).
/// `failures` counts consecutive delivery errors; 404/410 from the push
/// service deletes the row outright.
model PushSubscription {
  id         String    @id @default(cuid())
  did        String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  failures   Int       @default(0)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([did])
}

/// Cached Bluesky follow list for a signed-in user (DIDs as a JSON array),
/// refreshed from the public AppView at most once an hour. Lets the home
/// page surface shows by people they follow and rooms their follows are in.
model FollowCache {
  did       String   @id
  follows   String   @default("[]")
  count     Int      @default(0)
  fetchedAt DateTime @default(now())
}

/// Cached Bluesky block list for a signed-in user (DIDs as a JSON array).
/// Unlike follows, `app.bsky.graph.getBlocks` is scoped to the caller and
/// needs an authenticated request, so this is only ever filled for the
/// viewer themself. Used to hide blocked hosts and shows from them.
model BlockCache {
  did       String   @id
  blocks    String   @default("[]")
  count     Int      @default(0)
  fetchedAt DateTime @default(now())
}
