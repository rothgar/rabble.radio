{
  "name": "rabble",
  "version": "0.1.0",
  "private": true,
  "description": "Rabble — live audio spaces for Bluesky",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "gen:jwks": "tsx scripts/gen-jwks.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:prod": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --env production",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "d1:migrate:local": "wrangler d1 migrations apply rabble-dev --local",
    "d1:migrate:remote": "wrangler d1 migrations apply rabble-dev --remote",
    "d1:migrate:prod": "wrangler d1 migrations apply rabble-prod --remote --env production"
  },
  "dependencies": {
    "@atproto/api": "^0.30.0",
    "@atproto/jwk-jose": "^0.2.4",
    "@atproto/jwk-webcrypto": "^0.3.4",
    "@atproto/oauth-client": "^0.9.0",
    "@atproto/oauth-client-node": "^0.5.13",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "@livekit/components-react": "^2.9.24",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "6.19.3",
    "iron-session": "^9.0.1",
    "jose": "^6.2.14",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@opennextjs/cloudflare": "^1.20.15",
    "@prisma/nextjs-monorepo-workaround-plugin": "6.19.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "happy-dom": "21.0.4",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "jose": "^6.2.14"
    }
  }
}
