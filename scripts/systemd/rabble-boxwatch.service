[Unit]
Description=Notice discoboxes stopped on a Claude usage limit and resume them (scripts/box-watch.mjs)

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/bin:/bin
Environment=BOXWATCH_FALLBACK_MODEL=qwen3.8-27b-nvfp4
ExecStart=/etc/profiles/per-user/%u/bin/node %h/src/rabble.radio/scripts/box-watch.mjs
